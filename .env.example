# Which provider to use: gemini | groq | openrouter | cerebras | mistral | openai
AI_PROVIDER=gemini

# Free key for the default provider: https://aistudio.google.com/apikey
AI_API_KEY=

# Optional overrides. Free-tier model names and quotas change often; if a
# request 404s or you hit daily caps, change AI_MODEL rather than editing
# src/lib/ai/provider.ts.
#
# Gemini free-tier reality (measured 2026-09-01):
#   gemini-3.5-flash-lite  default — larger quota, completed full builds
#   gemini-3.6-flash       better quality, but ~5 req/min AND ~20 req/DAY
# AI_MODEL=gemini-3.5-flash-lite

# For a provider not in the preset table:
# AI_BASE_URL=

# Request shaping. Set a value to "none" to omit the parameter entirely
# (some models reject max_tokens/temperature). Malformed values fall back to
# the defaults instead of breaking requests.
# AI_MAX_TOKENS=8192
# AI_TEMPERATURE=0.2

# Attempts per request on 429/5xx (default 8). Free tiers meter per minute
# while one build costs 10-20 requests, so retries with backoff are what make
# free keys usable at all.
# AI_MAX_RETRIES=8

# Loop guard: how many tool rounds one message may take before stopping.
# AGENT_MAX_ITERATIONS=25
